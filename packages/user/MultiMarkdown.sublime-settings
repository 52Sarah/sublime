{
	"extensions":["mmd", "md"],
  "tab_size": 2, //! 4

  "color_scheme": "Packages/User/color-schemes/MarkdownEditor.tmTheme",
  // "color_scheme": "Packages/MarkdownEditing/MarkdownEditor.tmTheme",
  // "color_scheme": "Packages/MarkdownEditing/MarkdownEditor-Dark.tmTheme",
  // "color_scheme": "Packages/MarkdownEditing/MarkdownEditor-Yellow.tmTheme",

  // This is a quick and dirty focus theme. In order to make it work, you've to
  // set `"highlight_line": true,` in this settings file. It is likely that there will
  // be more mature focus improvements in the future (maybe similar to iA Writer).
  // "color_scheme": "Packages/MarkdownEditing/MarkdownEditor-Focus.tmTheme",

  "trim_trailing_white_space_on_save": true, //! false

  // Layout
  "draw_centered": false, //! true
  "word_wrap": true,
  "wrap_width": 120,
  "rulers": [120], //! []

  // Line
  "line_numbers": true, //! false
  "highlight_line": true, //! false
  "line_padding_top": 1, //! 2
  "line_padding_bottom": 1, //! 2

  // Caret
  "caret_style": "smooth", //! wide
  "caret_extra_top": 2, //! 3
  "caret_extra_bottom": 2, //! 3
}
