{
  /* You can disable the additional autocompletion provided by this package for specific source files and even select 
   * syntax within files. 
   */

  // disable completions when you're editing these types of files; e.g., "css", "js"
  "exclude_from_completion": [
  ],

  // do not source completions from thse types of files; e.g., "markdown"
