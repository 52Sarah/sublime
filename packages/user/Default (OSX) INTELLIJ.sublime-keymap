/*
    In an effort to familiarize myself with IntelliJ's key mappings, this mapping file
    attempts to swap out Sublime's elegant mappings for IntelliJ's insanity.
*/
[
    // HIDE ALL WINDOWS: ⌘+SHIFT+F12
    // sublime: ⌃⌘M  also ⌘K, ⌘B: toggle side bar
    { "keys": ["command+shift+f12"], "command": "toggle_side_bar" }

    // FIND ACTION: ⌘+SHIFT+A
    // sublime: ⌘+SHIFT+P, command palette
    , { "keys": ["super+shift+a"], "command": "show_overlay", "args": {"overlay": "command_palette"} }
    , { "keys": ["super+shift+p"], "command": "nil"}

    // DELETE LINE: ⌘+⌫
    // sublime: ⌘D
    , { "keys": ["command+backspace"], "command": "run_macro_file",
        "args": {"file": "res://Packages/Default/Delete Line.sublime-macro"} }

    // MOVE LINE UP, DOWN: ⌥+SHIFT+▲, ⌥+SHIFT+▼
    // sublime: ⌥+▲, ⌥+▼
    , { "keys": ["option+shift+up"], "command": "swap_line_up" }  //plus control+command+up
    , { "keys": ["option+shift+down"], "command": "swap_line_down" }  //plus control+command+down

    // GOTO DECLARATION: ⌘+B
    // sublime: ⌥+⌘-DOWN
    , { "keys": ["f3"], "command": "goto_definition" }  //plus option+command+down

    // DUPLICATE LINE: ⌘+D
    // sublime: ⌥+⌘+▲
    , { "keys": ["command+d"], "command": "duplicate_line" }  //plus super+shift+d

    // FIND UNDER EXPAND (MULTI-CURSOR): ^G
    // sublime: ⌃D
    , { "keys": ["control+g"], "command": "find_under_expand" }

/*
    no correlary in IntelliJ
*/

    // ⌘K, ⌘I   auto-indent
    , { "keys": ["command+k", "command+i"], "command": "reindent", "args": {"single_line": true} }

    // ⌘K, ⌘R   toggle find regex
    , { "keys": ["super+k", "super+r"], "command": "toggle_regex", "context":
        [{ "key": "setting.is_widget", "operator": "equal", "operand": true }]
    }
    // ⌘K, ⌘C   toggle find case-sensitive
    , { "keys": ["super+k", "super+c"], "command": "toggle_case_sensitive", "context":
        [{ "key": "setting.is_widget", "operator": "equal", "operand": true }]
    }

    // ⌥⌘R      refresh project (replacing toggle regex)
    , { "keys": ["option+command+r"], "command": "refresh_folder_list" }

    // ⌥⌘[,]    edit project
    , { "keys": ["option+command+,"], "command": "open_file", "args":  {"file": "${project}"} }

    // ⌃⇥ and ⌃⇧⇥  next/prev view/tab (instead of using stack)
    , { "keys": ["control+tab"], "command": "next_view" }
    , { "keys": ["control+shift+tab"], "command": "prev_view" }

    // ⌃⌘[,]    key bindings
    , { "keys": ["control+command+,"], "command": "edit_settings",
        "args": {
            "base_file": "${packages}/Default/Default ($platform).sublime-keymap",
            "default": "[\n\t$0\n]\n"
        }
      }


/*
    Eclipse-like bindings
*/

    // ⌘F
    , { "keys": ["command+f"], "command": "show_panel", "args": {"panel": "replace", "reverse": false} }
    // ⌃⌘F
    , { "keys": ["control+command+f"], "command": "toggle_distraction_free" }  // plus control+shift+command+f
    // ⌥⌘F
    , { "keys": ["option+command+f"], "command": "show_panel", "args": {"panel": "find_in_files"} }  // plus shift+command+f

    // eclipse doesn't have an actual "find next instance of last search",
    // but rather command-g finds next instance of selected text. Its
    // ⌘-option-g is "find all text in workspace".
    // To emulate this as closely as possinle, we'll swap command-g
    // and command-option-g to be "find_under" and "find_next".
    //, { "keys": ["command+g"], "command": "find_under" }
    //, { "keys": ["option+command+g"], "command": "find_next" }

    // ⌥⌘L      toggle line numbers
    , { "keys": ["option+command+l"], "command": "toggle_setting",
        "args": {"setting": "line_numbers" } }

    // ⌥⌘U      toggle gutter
    , { "keys": ["option+command+u"], "command": "toggle_setting",
        "args": {"setting": "gutter" } }

    // ⌥⌘Y      toggle word wrap
    , { "keys": ["option+command+y"], "command": "toggle_setting",
        "args": {"setting": "word_wrap" } }

    // ⌃[.]     hippie completion
    , { "keys": ["control+."], "command": "auto_complete" } //plus control+space



    // plugin: filter lines

    // ⌘K, ⌘R   edit -> lines -> filter with regex (k-s is with string)
    , { "keys": ["command+k","command+r"],
        "command": "prompt_filter_to_lines",
        "args": {"invert_search": "false", "search_type": "regex"}
    }


    // plugin: markdown preview

    // // [F12]    preview in browser
    // , { "keys": ["f12"], "command": "markdown_preview_select", "args": {"target": "browser"} }


    // plugin: extended tab switcher
    // (note that commnd-k, command-e is recent-active-files)
    // Eclipse uses ⌘E for this, so we'll follow suit

    // ⌘E       list all open files in current window (also ⌃⌥⇥)
    // ⇧⌘E      list all open files in current group/pane (also ⇧⌃⌥⇥)
    , { "keys": ["command+e"], "command": "extended_switcher", "args": {"list_mode": "window"} }
    , { "keys": ["shift+command+e"], "command": "extended_switcher", "args": {"list_mode": "active_group"} }


    // plugin: sublime bookmarks

    // override OOTB bookmark keys
    // ⌘[F2]    toggle
    , { "keys": ["command+f2"], "command": "sublime_bookmark", "args" : { "type" : "toggle_line"  } }
    // ⌃[F2]    add
    , { "keys": ["control+f2"], "command": "sublime_bookmark", "args" : { "type" : "add"  } }
    // [F2]     next
    , { "keys": ["f2"], "command": "sublime_bookmark", "args" : { "type" : "goto_next" } }
    // ⇧[F2]    previous
    , { "keys": ["shift+f2"], "command": "sublime_bookmark", "args" : { "type" : "goto_previous" } }

    // in addition to overriding the OOTB bookmark keys, add ⌘B sequences
    , { "keys": ["command+b"], "command": "noop" }  // have to turn ⌘B off so it can be a combo prefix
    // ⌘B, ⌘B   toggle bookmark
    , { "keys": ["command+b","command+b"], "command": "sublime_bookmark", "args" : { "type" : "toggle_line"  } }
    // ⌘B, ⌘A   add [named] bookmark
    , { "keys": ["command+b","command+a"], "command": "sublime_bookmark", "args" : { "type" : "add"  } }
    // ⌘B, ⌘N   next bookmark
    , { "keys": ["command+b","command+n"], "command": "sublime_bookmark", "args" : { "type" : "goto_next" } }
    // ⌘B, ⌘P   previous bookmark
    , { "keys": ["command+b","command+p"], "command": "sublime_bookmark", "args" : { "type" : "goto_previous" } }
    // ⌘B, ⌘B   goto bookmark
    , { "keys": ["command+b","command+g"], "command": "sublime_bookmark", "args" : { "type" : "goto" } }


    // plugin: preferences helper

    // defaults left as-is:
    //  ⇧⌘[,]   list setting files to open
    //  ⇧⌘[;]   fill current setting value with default pref value

    // ⇧⌘[.]    switch between default and user prefs
    , { "keys": ["shift+super+."], "command": "pref_toggle_setting_file",
        "context": [ { "key": "selector", "operator": "equal", "operand": "source.json" } ] }

]
