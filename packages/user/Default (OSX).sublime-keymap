  //
  //  NEXT/PREV CHANGE:             F7 / [Shift]+F7
  //  REVERT CHANGE:                [⌘]+[⌥]+F7
  //  DIFF POPUP:                   [^]+F7
  {"keys":["f7"], "command":"git_gutter_next_change"},
  {"keys":["shift+f7"], "command":"git_gutter_prev_change"},
  {"keys":["super+alt+f7"], "command":"git_gutter_revert_change"},
  {"keys":["ctrl+f7"], "command":"git_gutter_diff_popup"},
