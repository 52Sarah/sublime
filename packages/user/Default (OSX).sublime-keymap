  {"keys":["ctrl+b", "ctrl+up"],    "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"left"}}}},
  {"keys":["ctrl+b", "ctrl+left"],  "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"left"}}}},
  {"keys":["ctrl+b", "ctrl+l"],     "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"left"}}}},
  {"keys":["ctrl+b", "ctrl+down"],  "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"right"}}}},
