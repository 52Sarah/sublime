/********
  In an effort to familiarize myself with IntelliJ's key mappings, this mapping file
  attempts to swap out Sublime's elegant mappings for IntelliJ's insanity. Unless otherwise
  notes, keystrokes are an attempt to match up with Intellij IDEA.
*/
[
  //  DISABLE UNUSED KEYMAPS:
  {"command":"noop", "keys":["ctrl+d"]},      // delete forward


  //  VIEW - NEXT/PREV:             [^]+RIGHT / [^]+LEFT
  //  - plus default:               [⌘]+[Shift]+] / [⌘]+[Shift]+[
  //  - plus default:               [⌘]+[⌥]+RIGHT / [⌘]+[⌥]+LEFT
  { "keys": ["super+shift+["], "command": "prev_view" },
  { "keys": ["super+shift+]"], "command": "next_view" },

  //  AUTO-INDENT:                  [⌘]+K, [⌘]+I
  {"keys":["super+k", "super+i"], "command":"reindent", "args":{"single_line":true}},

  //  Sublime's built-in bookmark system.
  //  This is an iteration atop IntelliJ's scheme, which I've modified there to line up.
  //  BOOKMARK, TOGGLE:             [⌘]+F3, plus default: [⌘]+F2
  //  BOOKMARKS, NEXT/PREV:         F3 / [Shift]+F3, plus default: [^]+F2
  //    
  {"keys":["super+f3"], "command":"toggle_bookmark", "args":{"type":"toggle_line" }},
  {"keys":["f3"], "command":"next_bookmark", "args":{"type":"goto_next"}},
  {"keys":["shift+f3"], "command":"prev_bookmark", "args":{"type":"goto_previous"}},
  
  //  COLOR SCHEME:                 [⌥]+F5
  {"keys":["alt+f5"], "command":"select_color_scheme"},

  //  COMMAND PALETTE:              [⌘]+[Shift]+A
  //  - plus default:               [⌘]+[Shift]+P
  {"keys":["super+shift+a"], "command":"show_overlay", "args":{"overlay":"command_palette"}},

  //  FIND/REPLACE IN FILES:        [⌘]+[⌥]+F
  //  - plus default:               [⌘]+[Shift]+F
  {"keys":["super+alt+f"], "command":"show_panel", "args":{"panel":"find_in_files"}},
  //
  //  FIND, REPLACE:                [⌘]+R
  {"keys":["super+r"], "command":"show_panel", "args":{"panel":"replace", "reverse":false}},
  //
  //  FIND, TOGGLE REGEX:           [⌘]+K, [⌘]+[Shift]+R
  //  - default [⌘]+[⌥]+R remapped to PROJECT, REFRESH
  {"keys":["super+k", "super+shift+r"], "command":"toggle_regex", "args":[{"key":"setting.is_widget", "operator":"equal", "operand":true }],},
  //
  //  FIND, TOGGLE CS/CI:           [⌘]+K, [⌘]+[Shift]+C
  //  - default:                    [⌘]+[⌥]+C clobbered by INSERT TO COLUMN
  {"keys":["super+k", "super+shift+c"], "command":"toggle_case_sensitive", "args":[{"key":"setting.is_widget", "operator":"equal", "operand":true }],},
  
  //  FONT SIZE:                    [^]+[Shift]+LESS_THAN, [^]+[Shift]+GREATER_THAN
  //  - plus default:               [⌘]+PLUS, [⌘]+MINUS
  { "keys": ["ctrl+shift+."], "command": "increase_font_size" },
  { "keys": ["ctrl+shift+,"], "command": "decrease_font_size" },
  
  //  GOTO DECLARATION:             [⌘]+B
  //  - plus default:               [⌘]+[⌥]+DOWN
  {"keys":["super+b"], "command":"goto_definition"},
  //
  //  GOTO LINE START/END:          HOME / END
  //  SELECT TO LINE START/END:     [Shift]+HOME / [Shift]+END
  //  - plus defaults:
  //    GOTO START/END:             [⌘]+LEFT / [⌘]+RIGHT
  //    SELECT TO START/END:        [⌘]+[Shift]+LEFT / [⌘]+[Shift]+RIGHT
  {"keys":["home"],       "command":"move_to", "args":{"to":"bol"}},
  {"keys":["end"],        "command":"move_to", "args":{"to":"eol"}},
  {"keys":["shift+home"], "command":"move_to", "args":{"to":"bol", "extend":true}},
  {"keys":["shift+end"],  "command":"move_to", "args":{"to":"eol", "extend":true}},
  //
  //  GOTO FILE START/END:          [⌘]+HOME / [⌘]+END
  //  SELECT TO FILE START/END:     [⌘]+[Shift]+HOME / [⌘]+[Shift]+END
  //  - plus defaults:
  //    GOTO START/END:             [⌘]+UP / [⌘]+DOWN
  //    SELECT TO START/END:        [⌘]+[Shift]+UP / [⌘]+[Shift]+DOWN
  {"keys":["super+home"],       "command":"move_to", "args":{"to":"bof"}},
  {"keys":["super+end"],        "command":"move_to", "args":{"to":"eof"}},
  {"keys":["super+shift+home"], "command":"move_to", "args":{"to":"bof", "extend":true}},
  {"keys":["super+shift+end"],  "command":"move_to", "args":{"to":"eof", "extend":true}},
  //
  //  GOTO PREV/NEXT LOC:           [⌘]+[ / [⌘]+]
  //  - plus defaults:              [⌃]+MINUS / [⌃]+[Shift]+MINUS
  //  - clobbers default UNINDENT/INDENT
  {"keys":["super+["], "command":"jump_back"},
  {"keys":["super+]"], "command":"jump_forward"},
  //
  //  GOTO LINE:                    [⌘]+L
  //  - clobbers default: expand_selection {"to": "line"}
  {"keys":["super+l"], "command":"show_overlay", "args":{"overlay":"goto", "text":":"}},
  //
  //  GOTO SYMBOL:                  [⌘]+[⌥]+O
  //  - clobbers default: TOGGLE OVERWRITE
  {"keys":["super+alt+o"], "command":"show_overlay", "args":{"overlay":"goto", "text":"@"}},

  //  HIPPIE COMPLETION:            [⌘]+; or[⌥]+/ or [⌃]+.
  //  - plus default:               [⌃]+SPACE
  {"keys":["super+;"], "command":"auto_complete"},
  {"keys":["alt+/"],  "command":"auto_complete"},
  {"keys":["ctrl+."], "command":"auto_complete"},
  {"keys":["ctrl+ "], "command":"auto_complete"},

  //  KEY BINDINGS:                 [⌘]+[⌃]+COMMA
  {"keys":["super+ctrl+,"], "command":"edit_settings", "args":{"base_file":"${packages}/Default/Default ($platform).sublime-keymap", "default":"[\n\t$0\n]\n"}},

  //  LINE, DELETE:                 [⌘]+BACKSPACE
  //  - default [⌘]+D remapped to DUPLICATE LINE
  {"keys":["super+backspace"], "command":"run_macro_file", "args":{"file":"res://Packages/Default/Delete Line.sublime-macro"}},
  //
  //  LINE, DUPLICATE:              [⌘]+D
  //  - plus default:               [⌘]+[Shift]+D
  {"keys":["super+d"], "command":"duplicate_line"},
  //
  //  LINE, MOVE UP/DOWN:           [⌥]+[Shift]+UP / [⌥]+[Shift]+DOWN
  //  - plus defaults:              [⌘]+[⌃]+UP / [⌘]+[⌃]+DOWN
  {"keys":["alt+shift+up"],   "command":"swap_line_up"},
  {"keys":["alt+shift+down"], "command":"swap_line_down"},

  //  LOCAL HISTORY:                [⌘]+K, [⌘]+[Shift]+L
  {"keys":["super+k", "super+shift+l"], "command":"history_open"},

  //  MULTI-CURSOR:                 [^]+G
  //  - default [⌘]+D remapped to DELETE LINE
  {"keys":["ctrl+g"], "command":"find_under_expand"},
  //
  //  MULTI-CURSOR SPLIT LINES:     [⌥]+[Shift]+G
  //  - plus default:               [⌘]+[Shift]+L
  { "keys": ["alt+shift+g"], "command": "split_selection_into_lines" },
  //
  //  MULTI-CURSOR UNSELECT LAST:   [^]+[Shift]+G
  { "keys": ["ctrl+shift+g"], "command": "soft_undo" },
  //
  //  MULTI-CURSOR SKIP:            [⌘]+K, [^]+G
  //  - default [⌘]+K, [⌘]+D mapped to FILEDIFFS MENU
  {"keys":["super+k", "ctrl+g"], "command":"find_under_expand_skip"},


  //  PROJECT, EDIT:                [⌘]+[⌥]+COMMA
  {"keys":["super+alt+,"], "command":"open_file", "args": {"file":"${project}"}},
  //
  //  PROJECT, REFRESH (FOLDERS):   [⌘]+[⌥]+R
  //  - clobbers default: TOGGLE REGEX
  {"keys":["super+alt+r"], "command":"refresh_folder_list"},
  //
  //  PROJECT, CLOSE:                [⌘]+K, [⌘]+[Shift]+W
  {"keys":["super+k", "super+shift+w"], "command":"close_workspace"},
  //
  //  PROJECT, OPEN RECENT:                [⌘]+K, [⌘]+[Shift]+O
  {"keys":["super+k", "super+shift+o"], "command":"prompt_open_project_or_workspace"},


  //  REVERT/RELOAD FILE:           [⌘]+[⌃]+R
  {"keys":["super+ctrl+r"], "command":"revert"},


  //  SHOW FILES:                   [⌘]+[Shift]+O
  //  - plus default:               [⌘]+T, [⌘]+P
  { "keys": ["super+shift+o"], "command": "show_overlay", "args": {"overlay": "goto", "show_files": true} },
  

  //  TOGGLE GUTTER:                [⌘]+[⌥]+U
  {"keys":["super+alt+u"], "command":"toggle_setting", "args":{"setting":"gutter"}},
  //
  //  TOGGLE LINE NUMBERS:          [⌘]+[⌥]+L or [⌘]+K, [⌘]+[Shift]+N
  {"keys":["super+alt+l"],       "command":"toggle_setting", "args":{"setting":"line_numbers"}},
  {"keys":["super+k", "super+shift+n"], "command":"toggle_setting", "args":{"setting":"line_numbers"}},
  //
  //  TOGGLE SIDE BAR:              [⌘]+[⌥]+[ or [⌘]+[⌥]+S or [⌘]+[Shift]+F12
  //  - plus default:               [⌘]+K, [⌘]+B
  {"keys":["super+alt+["],  "command":"toggle_side_bar"},
  {"keys":["super+alt+s"],  "command":"toggle_side_bar"},
  {"keys":["super+shift+f12"], "command":"toggle_side_bar"},
  //
  //  TOGGLE SPELL CHECK::          [⌘]+K, [⌘]+S
  {"keys":["super+alt+u"], "command":"toggle_setting", "args":{"setting":"gutter"}},
  //
  //  TOGGLE WORD WRAP:             [⌘]+[⌥]+Y or [⌘]+K, [⌘]+W
  {"keys":["super+alt+y"],       "command":"toggle_setting", "args":{"setting":"word_wrap"}},
  {"keys":["super+k", "super+w"], "command":"toggle_setting", "args":{"setting":"word_wrap"}},


  //
  //  UPPERCASE:                    [⌘]+[Shift]+U
  //  - plus default:               [⌘]+K, [⌘]+U
  { "keys": ["super+shift+u"], "command": "upper_case" },


