  {"keys":["ctrl+b", "ctrl+r"],     "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"right"}}}},
  //
  //  SELECT TO LEFT BRACKET:     [^]+B, [^]+[Shift]+UP or [^]+B, [^]+[Shift]+LEFT or [^]+B, [^]+[Shift]+L
  //  SELECT TO RIGHT BRACKET:    [^]+B, [^]+[Shift]+DOWN or [^]+B, [^]+[Shift]+RIGHT or [^]+B, [^]+[Shift]+R
  {"keys":["ctrl+b", "ctrl+shift+up"],    "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"left", "extend":true}}}},
  {"keys":["ctrl+b", "ctrl+shift+left"],  "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"left", "extend":true}}}},
  {"keys":["ctrl+b", "ctrl+shift+l"],     "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"left", "extend":true}}}},
  {"keys":["ctrl+b", "ctrl+shift+down"],  "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"right", "extend":true}}}},
  {"keys":["ctrl+b", "ctrl+shift+right"], "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"right", "extend":true}}}},
  {"keys":["ctrl+b", "ctrl+shift+r"],     "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"right", "extend":true}}}},
  //
  //  SELECT TEXT INCLUDING BRACKETS: [^]+B, [^]+S
