/********
  In an effort to familiarize myself with IntelliJ's key mappings, this mapping file
  attempts to swap out Sublime's elegant mappings for IntelliJ's insanity. Unless otherwise
  notes, keystrokes are an attempt to match up with Intellij IDEA.
*/
[
  //  AUTO-INDENT:                  [⌘]+K, [⌘]+I
  {"keys":["super+k", "super+i"], "command":"reindent", "args":{"single_line":true}},

  //
  //  Sublime's built-in bookmark system.
  //  This is an iteration atop IntelliJ's scheme, which I've modified there to line up.
  //  These keys are generally superseded by SUBLIME BOOKMARKS, below.
  //
  //  BOOKMARK, TOGGLE:             [⌘]+F3
  //  overriden by plugin
  //  disable defaults: [⌘]+F2 or [⌃]+[Shift]+R
  {"command":"noop", "keys":["super+f2"]},      // toggle_bookmark
  {"command":"noop", "keys":["ctrl+shift+r"]},  // toggle_bookmark
  //
  //  BOOKMARKS, NEXT/PREV:         F3 / [Shift]+F3
  //  overriden by plugin
  //  disable defaults: F2 or [⌃]+R / [Shift]-F2
  {"command":"noop", "keys":["f2"]},            // next_bookmark
  {"command":"noop", "keys":["ctrl+r"]},        // next_bookmark
  {"command":"noop", "keys":["shift+f2"]},      // prev_bookmark
  //
  //  BOOKMARKS, CLEAR:             [⌘]+[^]+F3
  //  overriden by plugin
  //  disable default: [⌘]+[Shift]+F2
  {"command":"noop", "keys":["super+shift+f2"]},  // clear_bookmarks


  //  COMMAND PALETTE:              [⌘]+[Shift]+A
  //  - plus default:               [⌘]+[Shift]+P
  {"keys":["super+shift+a"], "command":"show_overlay", "args":{"overlay":"command_palette"}},


  //  FIND/REPLACE IN FILES:        [⌘]+[⌥]+F
  //  - plus default:               [⌘]+[Shift]+F
  {"keys":["super+alt+f"], "command":"show_panel", "args":{"panel":"find_in_files"}},
  //
  //  FIND, REPLACE:                [⌘]+R
  {"keys":["super+r"], "command":"show_panel", "args":{"panel":"replace", "reverse":false}},
  //
  //  FIND, TOGGLE REGEX:           [⌘]+K, [⌘]+[Shift]+R
  //  - default [⌘]+[⌥]+R remapped to PROJECT, REFRESH
  {"keys":["super+k", "super+shift+r"], "command":"toggle_regex", "args":[{"key":"setting.is_widget", "operator":"equal", "operand":true }],},
  //
  //  FIND, TOGGLE CS/CI:           [⌘]+K, [⌘]+[Shift]+C
  //  - plus default:               [⌘]+[⌥]+C
  {"keys":["super+k", "super+shift+c"], "command":"toggle_case_sensitive", "args":[{"key":"setting.is_widget", "operator":"equal", "operand":true }],},


  //  GOTO DECLARATION:             [⌘]+B
  //  - plus default:               [⌘]+[⌥]+DOWN
  {"keys":["super+b"], "command":"goto_definition"},
  //
  //  GOTO FILE START/END:          [⌘]+HOME / [⌘]+END
  //  SELECT TO FILE START/END:     [⌘]+[Shift]+HOME / [⌘]+[Shift]+END
  //  - plus defaults:
  //    GOTO START/END:             [⌘]+UP / [⌘]+DOWN
  //    SELECT TO START/END:        [⌘]+[Shift]+UP / [⌘]+[Shift]+DOWN
  {"keys":["super+home"],       "command":"move_to", "args":{"to":"bof"}},
  {"keys":["super+end"],        "command":"move_to", "args":{"to":"eof"}},
  {"keys":["super+shift+home"], "command":"move_to", "args":{"to":"bof", "extend":true}},
  {"keys":["super+shift+end"],  "command":"move_to", "args":{"to":"eof", "extend":true}},
  //
  //  GOTO PREV/NEXT LOC:           [⌘]+[ / [⌘]+]
  //  - plus defaults:              [⌃]+MINUS / [⌃]+[Shift]+MINUS
  //  - clobbers default UNINDENT/INDENT
  {"keys":["super+["], "command":"jump_back"},
  {"keys":["super+]"], "command":"jump_forward"},
  //
  //  GOTO SYMBOL:                  [⌘]+[⌥]+O
  //  - clobbers default: TOGGLE OVERWRITE
  {"keys":["super+alt+o"], "command":"show_overlay", "args":{"overlay":"goto", "text":"@"}},


  //  HIPPIE COMPLETION:            [⌘]+; or[⌥]+/ or [⌃]+.
  //  - plus default:               [⌃]+SPACE
  {"keys":["super+;"], "command":"auto_complete"},
  {"keys":["alt+/"],  "command":"auto_complete"},
  {"keys":["ctrl+."], "command":"auto_complete"},
  {"keys":["ctrl+ "], "command":"auto_complete"},

  //  KEY BINDINGS:                 [⌘]+[⌃]+COMMA
  {"keys":["super+ctrl+,"], "command":"edit_settings", "args":{"base_file":"${packages}/Default/Default ($platform).sublime-keymap", "default":"[\n\t$0\n]\n"}},


  //  LINE, DELETE:                 [⌘]+BACKSPACE
  //  - default [⌘]+D remapped to DUPLICATE LINE
  {"keys":["super+backspace"], "command":"run_macro_file", "args":{"file":"res://Packages/Default/Delete Line.sublime-macro"}},
  //
  //  LINE, DUPLICATE:              [⌘]+D
  //  - plus default:               [⌘]+[Shift]+D
  {"keys":["super+d"], "command":"duplicate_line"},
  //
  //  LINE, MOVE UP/DOWN:           [⌥]+[Shift]+UP / [⌥]+[Shift]+DOWN
  //  - plus defaults:              [⌘]+[⌃]+UP / [⌘]+[⌃]+DOWN
  {"keys":["alt+shift+up"],   "command":"swap_line_up"},
  {"keys":["alt+shift+down"], "command":"swap_line_down"},


  //  MULTI-CURSOR:                 [^]+G
  //  - default [⌘]+D remapped to DELETE LINE
  {"keys":["ctrl+g"], "command":"find_under_expand"},
  //
  //  MULTI-CURSOR SPLT LINES:      [⌥]+G
  //  - plus default:               [⌘]+[Shift]+L
  { "keys": ["alt+g"], "command": "split_selection_into_lines" },
  //
  //  MULTI-CURSOR SKIP:            [⌘]+K, [^]+G
  //  - default [⌘]+K, [⌘]+D mapped to FILEDIFFS MENU
  {"keys":["super+k", "ctrl+g"], "command":"find_under_expand_skip"},


  //  PROJECT, EDIT:                [⌘]­­­+[⌥]+COMMA
  {"keys":["super+alt+,"], "command":"open_file", "args": {"file":"${project}"}},
  //
  //  PROJECT, REFRESH (FOLDERS):   [⌘]+[⌥]+R
  //  - clobbers default: TOGGLE REGEX
  {"keys":["super+alt+r"], "command":"refresh_folder_list"},
  //
  //  PROJECT, CLOSE:                [⌘]­­­+K, [⌘]­­­+[Shift]+W
  {"keys":["super+k", "super+shift+w"], "command":"close_workspace"},


  //  REVERT/RELOAD FILE:           [⌘]­­­+[⌃]+R
  {"keys":["super+ctrl+r"], "command":"revert"},


  //  TOGGLE GUTTER:                [⌘]+[⌥]+U
  {"keys":["super+alt+u"], "command":"toggle_setting", "args":{"setting":"gutter"}},
  //
  //  TOGGLE LINE NUMBERS:          [⌘]+[⌥]+L or [⌘]+K, [⌘]+N
  {"keys":["super+alt+l"],       "command":"toggle_setting", "args":{"setting":"line_numbers"}},
  {"keys":["super+k", "super+n"], "command":"toggle_setting", "args":{"setting":"line_numbers"}},
  //
  //  TOGGLE SIDE BAR:              [⌘]+[⌥]+S or [⌘]+[Shift]+F12
  //  - plus default:               [⌘]+K, [⌘]+B
  {"keys":["super+alt+s"],  "command":"toggle_side_bar"},
  {"keys":["super+shift+f12"], "command":"toggle_side_bar"},
  //
  //  TOGGLE SPELL CHECK::          [⌘]+K, [⌘]+S
  {"keys":["super+alt+u"], "command":"toggle_setting", "args":{"setting":"gutter"}},
  //
  //  TOGGLE WORD WRAP:             [⌘]+[⌥]+Y or [⌘]+K, [⌘]+W
  {"keys":["super+alt+y"],       "command":"toggle_setting", "args":{"setting":"word_wrap"}},
  {"keys":["super+k", "super+w"], "command":"toggle_setting", "args":{"setting":"word_wrap"}},


  ////////////////////////////////////////////////////////////
  //
  //  plugin: BRACKET HIGHLIGHTER
  //
  //  TOGGLE GLOBAL ENABLE:       [^]+B, [^]+B
  //  TOGGLE HIGH-VIS:            [^]+B, [^]+[Shift]+B
  {"keys":["ctrl+b", "ctrl+b"], "command":"bh_toggle_enable"},
  {"keys":["ctrl+b", "ctrl+shift+b"], "command":"bh_toggle_high_visibility"},
  //
  //  JUMP TO MATCHING BRACKET:   [^]+B, [^]+M
  //  JUMP TO LEFT BRACKET:       [^]+B, [^]+UP or [^]+B, [^]+LEFT
  //  JUMP TO RIGHT BRACKET:      [^]+B, [^]+DOWN or [^]+B, [^]+RIGHT
  {"keys":["ctrl+b", "ctrl+m"], "command":"bh_key", "args":{"plugin":{"args":{"select":"right", "alternate":true}, "command":"bh_modules.bracketselect", "type":["__all__"]}}, "lines":true, "no_outside_adj":null},
  {"keys":["ctrl+b", "ctrl+up"], "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"left"}}}},
  {"keys":["ctrl+b", "ctrl+left"], "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"left"}}}},
  {"keys":["ctrl+b", "ctrl+down"], "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"right"}}}},
  {"keys":["ctrl+b", "ctrl+right"], "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"right"}}}},
  //
  //  SELECT TO LEFT BRACKET:     [^]+B, [^]+[Shift]+UP or [^]+B, [^]+[Shift]+LEFT
  //  SELECT TO RIGHT BRACKET:    [^]+B, [^]+[Shift]+DOWN or [^]+B, [^]+[Shift]+RIGHT
  {"keys":["ctrl+b", "ctrl+shift+up"], "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"left", "extend":true}}}},
  {"keys":["ctrl+b", "ctrl+shift+left"], "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"left", "extend":true}}}},
  {"keys":["ctrl+b", "ctrl+shift+down"], "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"right", "extend":true}}}},
  {"keys":["ctrl+b", "ctrl+shift+right"], "command":"bh_key", "args":{"no_outside_adj":null, "no_block_mode":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"select":"right", "extend":true}}}},
  //
  //  SELECT TEXT BETWEEN BRACKETS:   [^]+B, [^]+S
  //  SELECT TEXT INCLUDING BRACKETS: [^]+B, [^]+[Shift]+S
  {"keys":["ctrl+b", "ctrl+s"], "command":"bh_key", "args":{"no_outside_adj":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect"}}},
  {"keys":["ctrl+b", "ctrl+shift+s"], "command":"bh_key", "args":{"no_outside_adj":null, "lines" : true, "plugin":{"type":["__all__"], "command":"bh_modules.bracketselect", "args":{"always_include_brackets":true}}}},
  //
  //  WRAP SELECTION WITH BRACKETS:   [^]+B, [^]+W
  {"keys":["ctrl+b", "ctrl+w"], "command":"wrap_brackets"},


  ////////////////////////////////////////////////////////////
  //
  //  plugin: EXTENDED TAB SWITCHER
  //
  //  LIST FILES IN WINDOW:         [⌃]+TAB
  //  - similar to Intellij
  //  LIST FILES IN PANE:           [⌃]+[Shift]+TAB
  {"keys":["ctrl+tab"], "command":"extended_switcher", "args":{"list_mode":"window"}},
  {"keys":["shift+ctrl+tab"], "command":"extended_switcher", "args":{"list_mode":"active_group"}},
  //
  //  plus plugin defaults:
  //  LIST FILES IN WINDOW:       [⌥]+[⌃]+TAB
  //  LIST FILES IN PANE:         [⌥]+[⌃]+[Shift]+TAB


  ////////////////////////////////////////////////////////////
  //
  //  plugin: FILE DIFFS
  //
  //  DIFF MENU:                    [⌘]+K, [⌘]+D
  //  - clobbers default: MULTI-CURSOR SKIP
  {"keys":["super+k", "super+d"], "command":"file_diff_menu"},
 

  ////////////////////////////////////////////////////////////
  //
  //  plugin: FILE HISTORY
  //
  //  OPEN RECENT FILE (PROJECT):   [⌘]+[Shift]+T
  //  - clobbers plugin default: OPEN LATEST CLOSED
  //
  //  plus plugin defaults:
  //  OPEN RECENT FILE (GLOBAL):    [⌘]+[⌥]+[Shift]+T
  { "keys": ["super+shift+t"],     "command": "open_recently_closed_file"},


  ////////////////////////////////////////////////////////////
  //
  //  plugin: FILTER LINES
  //
  //  KEEP LINES WITH REGEX:        [⌘]+K, [⌘]+F
  //  EXCLUDE LINES W REGEX:        [⌘]+K, [⌘]+[Shift]+F
  {"keys":["super+k", "super+f"], "command":"prompt_filter_to_lines", "args":{"invert_search":false, "search_type":"regex"}},
  {"keys":["super+k", "super+shift+f"], "command":"prompt_filter_to_lines", "args":{"invert_search":true, "search_type":"regex"}},
  //
  //  plus plugin defaults:
  //  - KEEP LINES WITH REGEX:      [⌘]+K, [⌘]+R
  //  - KEEP LINES WITH STRING:     [⌘]+K, [⌘]+S

  ////////////////////////////////////////////////////////////
