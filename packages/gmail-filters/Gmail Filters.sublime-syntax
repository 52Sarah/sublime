%YAML 1.2
---
name: Gmail Filters
file_extensions:
  - .gmail-filters
first_line_match: <\?xml version='1\.0' encoding='UTF\-8'\?>
scope: text.xml text.gmail-filters
variables:
  # This is the full XML Name production, but should not be used where namespaces
  # are possible. Those locations should use a qualified_name.
  name: '[[:alpha:]:_][[:alnum:]:_.-]*'
  # This is the form that allows a namespace prefix (ns:) followed by a local
  # name. The captures are:
  #  1: namespace prefix name
  #  2: namespace prefix colon
  #  3: local tag name
  qualified_name: '(?:([[:alpha:]_][[:alnum:]_.-]*)(:))?([[:alpha:]_][[:alnum:]_.-]*)'
    
contexts:
  main:
    - match: '(<\?)(xml)(?=\s)'
      captures:
        1: punctuation.definition.tag.begin
        2: entity.name.tag
      push:
        - meta_scope: meta.tag.preprocessor
        - match: \?>
          scope: punctuation.definition.tag.end
          pop: true
        - match: '\s+{{qualified_name}}(=)?'
          captures:
            1: entity.other.attribute-name.namespace
            2: entity.other.attribute-name punctuation.separator.namespace
            3: entity.other.attribute-name.localname
            4: punctuation.separator.key-value
        - include: single-quoted-string
        - include: double-quoted-string

    - match: '<!--'
      scope: punctuation.definition.comment.begin
      push:
        - meta_scope: comment.block
        - match: '-->'
          scope: punctuation.definition.comment.end
          pop: true
        - include: filter-name
        - match: '-{2,}'
          scope: invalid.illegal.double-hyphen-within-comment

    - match: '(<)(/?feed)'
      captures:
        1: punctuation.definition.tag.begin
        2: entity.name.tag.feed
      push:
        - meta_scope: meta.tag.feed
        - match: /?>
          scope: punctuation.definition.tag.end
          pop: true
        - include: tag-stuff
    
    - match: '(<)(/?entry)'
      captures:
        1: punctuation.definition.tag.begin
        2: entity.name.tag.entry
      push:
        - meta_scope: meta.tag.entry
        - match: /?>
          scope: punctuation.definition.tag.end
          pop: true
        - include: tag-stuff
        
    # highlight label property's value
    - match: "(<)(apps)(:)(property) (name)(=)('label') (value)(=)('([^']+)')"
      captures:
        1: punctuation.definition.tag_.begin
        2: entity.name.tag_.namespace
        3: punctuation.separator.namespace
        4: entity.name.tag_.localname
        5: entity.other.attribute-name
        6: punctuation.separator.key-value
        7: string.quoted.single
        8: entity.other.attribute-name
        9: punctuation.separator.key-value
        10: string.quoted.single
        11: entity.name.type
      push:
        - meta_scope: meta.tag.property.filter.label
        - match: /?>
          scope: punctuation.definition.tag_.end
          pop: true
        - include: tag-stuff

    - match: (<)(apps)(:)(property)
      captures:
        1: punctuation.definition.tag_.begin
        2: entity.name.tag_.namespace
        3: entity.name.tag punctuation.separator.namespace
        4: entity.name.tag_.localname
      push:
        - meta_scope: meta.tag.property
        - match: /?>
          scope: punctuation.definition.tag_.end
          pop: true
        - include: tag-stuff

  tag-stuff:
    - match: '(?:\s+|^){{qualified_name}}\s*(=)'
      captures:
        1: entity.other.attribute-name.namespace
        2: entity.other.attribute-name punctuation.separator.namespace
        3: entity.other.attribute-name.localname
        4: punctuation.separator.key-value
    - match: '(?:\s+|^)([[:alnum:]:_.-]+)\s*(=)'
      captures:
        1: invalid.illegal.bad-attribute-name
        2: punctuation.separator.key-value
    - include: single-quoted-string-filter
    - include: single-quoted-string
    - include: double-quoted-string


  single-quoted-string-filter:
     - match: "(?<='hasTheWord' value=)'"
       scope: punctuation.definition.string.begin
       push:
        - meta_scope: string.quoted.single.filter
        - match: "'"
          scope: punctuation.definition.string.end
          pop: true
        - include: recursive-items

  # Bold the 999x__SNAKE_CASE "names" for each filter.
  filter-name:
    - match: '[A-Z]?\d{2,3}[a-z]*_+\w+'
      scope: .filter_name
  
  recursive-grouped-items:
    - include: parens-filter
    - include: braces-filter
    - include: double-quoted-string-filter
    - include: unquoted-word

  recursive-keyword-items:
    - include: keyword-and-value
    - include: keyword-only
    - include: conjunction-only
  
  recursive-items:
    - include: recursive-keyword-items
    - include: recursive-grouped-items


  # keyword-and-value:
  #   - match: '(\-?)(LABEL|IN|IS|BEFORE|AFTER|SIZE|LIST)(:)(?=\S+)'
  #     scope: .keyword_and_value
  #     captures:
  #       1: punctuation.separator
  #       2: keyword entity.name.type
  #       3: punctuation.separator
  #   - include: recursive-grouped-items

  keyword-and-value:
    - match: '(\-?)(LABEL|IN|IS|BEFORE|AFTER|SIZE|LIST)(:)(?=\S+)'
      scope: .keyword_and_value
      captures:
        1: punctuation.separator
        2: keyword entity.name.type
        3: punctuation.separator
    - include: value-only
    - include: recursive-grouped-items

  keyword-only:
    - match: '(\-?)(FROM|TO|SUBJECT)(:)'
      scope: .keyword_only
      captures:
        1: punctuation.separator
        2: keyword entity.name.type
        3: punctuation.separator

  value-only:
    - match: '(?<=\:)([\w_./]*)'
      scope: .value_only entity.name.type

  conjunction-only:
    - match: '[\(\{\s]\s*(AND|OR|AROUND)\s*[\)\}\s]'
      scope: .conjunction_only keyword

  double-quoted-string-filter:
    - match: '"'
      scope: punctuation.definition.string.begin
      push:
        - meta_scope: string.quoted.double.filter
        - match: '"'
          scope: punctuation.definition.string.end
          pop: true
        - include: parens-filter
        - include: braces-filter
        - include: conjunction-only

  braces-filter:
    - match: '\{'
      scope: punctuation.definition.brace.begin
      push:
        - meta_scope: braces.filter
        - match: '\}'
          scope: punctuation.definition.brace.end
          pop: true
        - include: filter-name
        - include: recursive-items

  parens-filter:
    - match: '\('
      scope: punctuation.definition.paren.begin
      push:
        - meta_scope: parens.filter
        - match: '\)'
          scope: punctuation.definition.paren.end
          pop: true
        - include: recursive-items

  unquoted-word:
    - match: '(?<=[^"''\w])[\w_./]+(?=[^:"''\w])'
      scope: .unquoted_word


  single-quoted-string:
    - match: "'"
      scope: punctuation.definition.string.begin
      push:
        - meta_scope: string.quoted.single
        - match: "'"
          scope: punctuation.definition.string.end
          pop: true

  double-quoted-string:
    - match: '"'
      scope: punctuation.definition.string.begin
      push:
        - meta_scope: string.quoted.double
        - match: '"'
          scope: punctuation.definition.string.end
          pop: true
