{
	"settings":
	{
		"color_scheme": "Packages/Dayle Rees Color Schemes/legacy/Contrast/Earthsong.tmTheme",
		"binary_file_patterns": ["*.cache", "*.ldb"],
		"follow_symlinks": true,
	},
	"folders":
	[
		{
			"name": "SUBLIME-PACKAGES",
			"path": ".",
			"folder_exclude_patterns": ["packages"],
			"file_exclude_patterns": ["*.user-ca-bundle"],
		},
		{
			"name": "User",
			"path": "./packages/user",
		},
		{
			"name": "gmail-filters",
			"path": "./packages/gmail-filters",
		},
		{
			"name": "sublime-keymap",
			"path": "./packages/sublime-keymap",
		},
		{
			"name": "$SUBLIME/Packages",
			"path": "~/Library/Application Support/Sublime Text 3/Packages",
			"folder_exclude_patterns": [
				"User",
				"Gmail Filters",
				"Sublime Keymap",
				"py*"
			],
			"file_exclude_patterns": [
				".extracted-sublime-package",
				"package-metadata.json",
			],
		},
		{
			"name": "$SUBLIME",
			"path": "~/Library/Application Support/Sublime Text 3",
			"folder_exclude_patterns": [
				".gitignore",
				".sublime",
				"Cache",
				"Index",
				"Lib",
				"Packages"
			],
			"file_exclude_patterns": [
				".gitignore",
				"LICENSE", "LICENSE.*", "*.sublime_license",
			],
		},
	]
}

